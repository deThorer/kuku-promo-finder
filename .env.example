# Copy this file to .env and fill in ONE provider. Only .env changes when you swap models.

# --- Option A: Google Gemini (free tier, recommended) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite   # any model name your key lists in Google AI Studio
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite   # used automatically when a model's daily quota runs out or it stops answering
GEMINI_API_KEY=

# --- Option B: Groq (free tier; small per-minute token cap, so add --no-camera for 3-4 episode selections) ---
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# --- Option C: any API Kuku gives you ---
# LLM_PROVIDER=anthropic            # ANTHROPIC_API_KEY
# LLM_PROVIDER=openai               # OPENAI_API_KEY
# LLM_PROVIDER=openrouter           # OPENROUTER_API_KEY
# LLM_PROVIDER=openai_compatible    # LLM_BASE_URL + LLM_API_KEY
# LLM_PROVIDER=ollama               # local model, no key

# --- Tuning ---
LLM_TEMPERATURE=0.4
LLM_MIN_INTERVAL=4      # seconds between calls, keeps you under free-tier requests-per-minute
LLM_MAX_RETRIES=5
